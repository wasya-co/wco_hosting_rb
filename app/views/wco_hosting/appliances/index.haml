
.appliances-index.maxwidth
  %h5
    Appliances
    = link_to '[+]', new_appliance_path

  %table.bordered.data-table
    %thead
      %td &nbsp;
      %td created_at
      %td tmpl
      %td host
      -# %td service_name
      %td port
      %td slug

    - @appliances.each do |app|
      %tr
        %td
          = link_to '[~]', edit_appliance_path(app)
          -# = link_to '[view]', appliance_path(app)
          .gray.mini= link_to app.id, appliance_path(app)
        %td
          = app.created_at
        %td= app.tmpl
        %td= app.host
        -# %td= app.service_name
        %td= app.port
        %td= app.slug

